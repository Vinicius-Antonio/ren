# Chave da Gemini API (Google AI Studio) — obrigatória
GEMINI_API_KEY=

# Modelo e voz da Gemini Live API
# Voz feminina natural; outras opções: Kore (firme), Callirrhoe (tranquila)
GEMINI_MODEL=gemini-3.8-live-extended-thinking
GEMINI_VOICE=Aoede
THINKING_LEVEL=LOW
SAFETY_THRESHOLD=BLOCK_ONLY_HIGH

# Caminho no Windows para o vault do Obsidian (Argon Hydrogen)
OBSIDIAN_VAULT_PATH=

# Picovoice Porcupine — opcional! Se vazio, a Ren usa o modelo offline gratuito
# Vosk em português (models/vosk-model-small-pt-0.3) para ouvir "Ren",
# ou a tecla Enter caso a pasta do modelo Vosk não exista.
PICOVOICE_ACCESS_KEY=
VOSK_MODEL_PATH=models/vosk-model-small-pt-0.3

# Modelo customizado da wake word "Ren". Se o arquivo não existir,
# usa a keyword built-in definida em WAKE_WORD_BUILTIN.
# Para modelos .ppn treinados em português, baixe também o arquivo de idioma
# porcupine_params_pt.pv do repositório oficial da Picovoice e coloque em models/.
WAKE_WORD_MODEL_PATH=models/ren.ppn
WAKE_WORD_LANGUAGE_MODEL_PATH=models/porcupine_params_pt.pv
WAKE_WORD_BUILTIN=jarvis
WAKE_WORD_SENSITIVITY=0.6

# VAD local (RMS + filtro espectral de voz humana; usa Silero ONNX se o arquivo existir)
VAD_SILENCE_THRESHOLD_RMS=500
VAD_SILENCE_TIMEOUT_SEC=6
SILERO_MODEL_PATH=models/silero_vad.onnx

# true = suprime o envio do microfone enquanto a Ren fala, exceto se detectar
# você falando mais alto para interromper (BARGE_IN_ENABLED=true com cancelamento de eco).
# false = envia o microfone continuamente ( filtrado pelo cancelador de eco).
HALF_DUPLEX=true
BARGE_IN_ENABLED=true

# Bips de ativação/desativação, localização e perfil do criador
SOUND_FX_ENABLED=true
USER_LOCATION=Santa Mariana, Paraná, Brasil
CREATOR_NAME=Vinícius Antonio De Oliveira
CREATOR_PROFILE=Desenvolvedor de software pleno 1 da Avenue

# Leitura de E-mails por Voz (Opcional — Gmail / Outlook via IMAP)
# Para Gmail, gere uma Senha de App de 16 letras em: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Bot do Discord (Opcional — para a Ren entrar e falar na chamada de voz)
# Crie o bot e pegue o Token em: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
DISCORD_TEXT_CHANNEL_ID=
DISCORD_DEFAULT_CHANNEL=Geral

