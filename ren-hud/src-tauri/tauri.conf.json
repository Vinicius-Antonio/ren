{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ren HUD",
  "version": "2.0.0",
  "identifier": "com.ren.hud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ren HUD",
        "width": 380,
        "height": 440,
        "x": 40,
        "y": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}

